* {
    font-family: "Segoe UI Variable", "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
    color: #F3F4F6;
}
QMainWindow, QWidget#AppRoot, QWidget#PageRoot, QStackedWidget#PageStack { background: #111315; }
QFrame#TopBar { background: #181B1F; border-bottom: 1px solid #2A2F35; }
QFrame#Sidebar { background: #181B1F; border-right: 1px solid #2A2F35; }
QLabel#BrandTitle { font-size: 15px; font-weight: 600; }
QLabel#BrandSubtitle, QLabel#SecondaryText, QLabel#PageDescription,
QLabel#CardLabel, QLabel#FieldLabel, QLabel#EmptyDescription, QLabel#PathLabel { color: #9CA3AF; }
QLabel#PageTitle { font-size: 24px; font-weight: 600; }
QLabel#SectionTitle { font-size: 16px; font-weight: 600; }
QLabel#CardValue { font-size: 26px; font-weight: 600; }
QListWidget#Navigation { background: transparent; border: none; outline: none; padding: 4px 10px; }
QListWidget#Navigation::item { border-radius: 8px; padding: 0 12px; margin: 2px 0; color: #C4C8D0; }
QListWidget#Navigation::item:hover { background: #23272D; }
QListWidget#Navigation::item:selected { background: #263452; color: #B9C8FF; }
QFrame#Card, QFrame#Panel, QFrame#FilterBar, QFrame#TaskProgress,
QGroupBox#SettingsGroup { background: #181B1F; border: 1px solid #2A2F35; border-radius: 10px; }
QFrame#Card[clickable="true"]:hover { border-color: #435B9B; background: #1B2028; }
QFrame#InfoBanner { background: #302719; border: 1px solid #5B4827; border-radius: 8px; }
QGroupBox#SettingsGroup { margin-top: 14px; padding: 18px 16px 14px 16px; font-size: 15px; font-weight: 600; }
QGroupBox#SettingsGroup::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; }
QPushButton { min-height: 34px; padding: 0 14px; background: #20242A; border: 1px solid #343A43; border-radius: 7px; }
QPushButton:hover { background: #292E35; border-color: #454C57; }
QPushButton:pressed { background: #303640; }
QPushButton:disabled { color: #686F79; background: #1A1D21; border-color: #282D33; }
QPushButton[variant="primary"] { background: #6D8DFF; color: #FFFFFF; border-color: #6D8DFF; }
QPushButton[variant="primary"]:hover { background: #5E7EEA; }
QPushButton[variant="danger"] { color: #FFAAA3; border-color: #70413E; }
QPushButton[variant="danger"]:hover { background: #392321; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 34px; padding: 0 10px; background: #15181C; border: 1px solid #343A43; border-radius: 7px; selection-background-color: #3C5695; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #6D8DFF; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView { background: #20242A; border: 1px solid #343A43; selection-background-color: #263452; }
QTableView { background: #181B1F; alternate-background-color: #1A1D21; border: 1px solid #2A2F35; border-radius: 9px; gridline-color: transparent; selection-background-color: #263452; selection-color: #F3F4F6; outline: none; }
QTableView::item { border-bottom: 1px solid #24282E; padding: 0 8px; }
QTableView::item:hover { background: #20252C; }
QHeaderView::section { background: #20242A; color: #9CA3AF; border: none; border-bottom: 1px solid #2A2F35; padding: 9px 8px; font-weight: 600; }
QProgressBar { min-height: 6px; max-height: 6px; background: #2A2F35; border: none; border-radius: 3px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #6D8DFF; border-radius: 3px; }
QScrollArea { border: none; background: transparent; }
QWidget#DetailContent { background: #181B1F; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical { background: #444B55; border-radius: 4px; min-height: 32px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSplitter::handle { background: transparent; width: 6px; }
QLabel[badge="true"] { border-radius: 6px; padding: 3px 8px; font-size: 12px; font-weight: 600; }
QLabel[status="success"] { background: #153B2D; color: #79D9AC; }
QLabel[status="info"] { background: #1D3158; color: #9AB5FF; }
QLabel[status="warning"] { background: #49351A; color: #F4BD64; }
QLabel[status="error"] { background: #482525; color: #FF9C96; }
QLabel[status="neutral"] { background: #2A2F35; color: #B3B8C0; }
